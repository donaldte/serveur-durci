# config.env : les réglages qui ne vont pas sur GitHub. Sur le serveur :
#   sudo cp config.env.exemple config.env && sudo nano config.env
# config.env est dans .gitignore : il reste sur le serveur, jamais dans le dépôt.

# Ton e-mail, pour Let's Encrypt : il prévient si un certificat va expirer.
EMAIL=""

# Des adresses que fail2ban ne bannit jamais, séparées par des espaces (la tienne, par exemple).
# Ton adresse vue d'Internet : curl -4 ifconfig.me, depuis ton ordinateur.
JAMAIS_BANNIES=""

# Le nom du serveur et le domaine, si ce ne sont pas ceux de la machine (rarement utile).
# NOM="$(hostname -s)"
# DOMAINE="formationdevops.xyz"
