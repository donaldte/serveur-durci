# Posé par serveur-durci (modules/90-deploiement-continu.sh), testé par visudo -c.
# deploy peut lancer le déploiement en root, sans mot de passe, avec un commit en argument
# (40 caractères hexadécimaux), et rien d'autre.
deploy ALL=(root) NOPASSWD: /usr/local/sbin/serveur-durci-deployer ^[0-9a-f]{40}$
