// Posé par serveur-durci (modules/40-mises-a-jour.sh) dans /etc/apt/apt.conf.d/.
// Pour apt, le dernier fichier lu gagne : celui-ci passe après 20auto-upgrades.

// Chaque jour, la liste des paquets est mise à jour, et les mises à jour de sécurité installées.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
// Le ménage d'après : les paquets devenus inutiles, et le cache, chaque semaine.
Unattended-Upgrade::Remove-Unused-Dependencies "true";
APT::Periodic::AutocleanInterval "7";
// Pas de redémarrage automatique : on choisit le moment (docs/decisions.md).
Unattended-Upgrade::Automatic-Reboot "false";
