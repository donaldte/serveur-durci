# Posé par serveur-durci (modules/30-fail2ban.sh) dans /etc/fail2ban/jail.d/.
# Ne le modifie pas sur le serveur : modifie le dépôt, pousse, puis sudo serveur-durci-deployer.

[DEFAULT]
# Jamais bannis : la machine elle-même, et les adresses de JAMAIS_BANNIES (config.env).
ignoreip = 127.0.0.1/8 ::1 @JAMAIS_BANNIES@
# 5 échecs en 10 minutes : banni pour 1 heure.
maxretry = 5
findtime = 10m
bantime = 1h
# Un récidiviste est banni deux fois plus longtemps à chaque fois, jusqu'à une semaine.
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1w

[sshd]
enabled = true
